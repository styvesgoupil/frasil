# FRASIL River's settings: copy to .env (nimbus: ~/apps/frasil/.env, never committed) and fill it in. A setting left
# empty takes its default (store.Settings). Secrets go only in .env, never here.

# the site's origin: the links in emails, the only Origin a change is accepted from
RIVER_URL=https://river.frasilsynth.com

# email (Zoho, SMTP over TLS: 465; 587 is STARTTLS). No SMTP_HOST: emails go to the log (a local run).
# noreply@frasilsynth.com is an alias of Styves's Zoho mailbox (no seat of its own): log in as that mailbox, with an
# app password, and send from the alias; an organization's mailbox uses smtppro.zoho.com (smtp.zoho.com: personal).
# 587 (STARTTLS): Hetzner blocks outgoing 25 and 465 (tried from nimbus 2026-10-23: 465 times out, 587 logs in)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=styves@graphoscope.app
SMTP_PASSWORD=
MAIL_FROM="FRASIL River <noreply@frasilsynth.com>"
# where a reply goes (and the emails' "Questions:" line); empty: none
MAIL_REPLY_TO=hi@frasilsynth.com

# Continue with Google (Google Cloud console, an OAuth client of type "Web application"). No GOOGLE_CLIENT_ID: off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://river.frasilsynth.com/api/auth/google/callback

# the admins: their emails, comma-separated (an admin's email must be verified on the River for it to count)
ADMIN_EMAILS=

# the word filter: words, comma-separated, replacing guard.py's WORDS (empty: those)
WORD_FILTER=

# where the client's address is (Cloudflare's header, passed on by Caddy); empty: the connection's
CLIENT_IP_HEADER=cf-connecting-ip

# 0 only for a local run over plain http
COOKIE_SECURE=1

# a folder served at / (a local run: build/website/river); empty on nimbus, where Caddy serves the page
RIVER_STATIC=

# set by docker-compose.yml: RIVER_DB=/data/river.sqlite; RIVER_SCHEMA defaults to schema.json beside the code
TZ=America/Toronto
